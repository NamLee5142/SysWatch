# SysWatch backend configuration.
#
# Copy this to syswatch.env next to the backend, or point SYSWATCH_CONFIG_FILE
# at it, and uncomment what you need. Environment variables override anything
# set here, so a one-off change does not need this file edited.
#
# syswatch.env itself is gitignored. This example is not, so keep real secrets
# out of it.

# --- required in production --------------------------------------------------

# The HMAC key for session tokens. There is no default and the process refuses
# to start without one. Generate with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it logs everyone out, so do not regenerate it on each deploy.
#SYSWATCH_SESSION_SECRET=

# --- serving -----------------------------------------------------------------

#SYSWATCH_HOST=127.0.0.1
#SYSWATCH_PORT=8000

# Where `npm run build` put the dashboard. Unset serves the API only, which is
# what you want while running the Vite dev server.
#SYSWATCH_DASHBOARD_DIR=C:\SysWatch\dashboard\dist

# Cross-origin access. Empty by default, and that is usually right: serving the
# dashboard from this process makes it same-origin, and the Vite dev proxy does
# the same in development. Only a dashboard hosted somewhere else needs this.
# Comma-separated; "*" is refused at startup.
#SYSWATCH_CORS_ORIGINS=https://dashboard.example.com

# --- data --------------------------------------------------------------------

# Where the database and logs live. Everything else derives from it, so moving
# this one setting moves the whole installation. Defaults to
# %PROGRAMDATA%\SysWatch, or ./data under SYSWATCH_DEV_MODE.
#SYSWATCH_DATA_DIR=C:\ProgramData\SysWatch
#SYSWATCH_DATABASE_URL=sqlite:///C:/ProgramData/SysWatch/syswatch.db
#SYSWATCH_LOG_DIR=C:\ProgramData\SysWatch\logs
# DEBUG, INFO, WARNING or ERROR. Rotates at 5 MB, five files kept.
#SYSWATCH_LOG_LEVEL=INFO
#SYSWATCH_RETENTION_DAYS=30

# --- collection --------------------------------------------------------------

#SYSWATCH_AGENT_BASE_URL=http://127.0.0.1:8080
#SYSWATCH_POLL_INTERVAL_SECONDS=10.0
#SYSWATCH_POLLING_ENABLED=true
#SYSWATCH_ALERTS_ENABLED=true

# --- alert delivery -----------------------------------------------------------

# Alerts are always recorded and always written to syswatch.log. Telling
# somebody is separate, and off until configured here. Both transports below
# are independent: one failing does not stop the other, and neither stops the
# poller collecting.

# Lowest severity that reaches a transport - info, warning or critical. The
# log is deliberately unfiltered, so nothing is lost, it just is not sent.
#SYSWATCH_NOTIFY_MIN_SEVERITY=warning

# Re-send a still-firing alert this often, in hours. 0 announces an alert once
# when it opens and once when it resolves. Acknowledging an alert stops its
# reminders; silencing its rule stops them until the silence expires.
#SYSWATCH_NOTIFY_REPEAT_HOURS=0

# Mail. HOST, FROM and TO are required together - setting some and not the
# rest is refused at startup rather than discovered when an alert does not
# arrive. Leave HOST unset to disable mail entirely.
#SYSWATCH_SMTP_HOST=smtp.example.com
#SYSWATCH_SMTP_PORT=587
#SYSWATCH_SMTP_FROM=syswatch@example.com
# Comma-separated, like SYSWATCH_CORS_ORIGINS.
#SYSWATCH_SMTP_TO=ops@example.com,oncall@example.com

# Optional, and set together or not at all: a username with no password
# authenticates as nobody, and a password with no username is a secret sitting
# in a file for no reason.
#
# Credentials are never sent over an unencrypted connection. STARTTLS is used
# when the server offers it; when it does not and a username is set, the send
# fails rather than putting this password on the network. Port 587 expects
# STARTTLS - implicit TLS on 465 is not supported.
#SYSWATCH_SMTP_USERNAME=syswatch@example.com
#SYSWATCH_SMTP_PASSWORD=

# Webhook. One POST per state change, carrying the alert as JSON. Anything
# that accepts a JSON POST works; Slack, Discord and Teams each need a small
# forwarder to reshape the body.
#
# Treat this URL as a credential - those services all put a token in the path.
# It is never logged, and http:// is accepted only with a startup warning,
# because the alert contents and any token in the URL would cross the network
# in clear.
#SYSWATCH_WEBHOOK_URL=https://hooks.example.com/services/T000/B000/XXXX

# --- development ---------------------------------------------------------------

# Development mode. Drops the session cookie's Secure flag so it survives plain
# HTTP, puts the data directory beside the checkout instead of in ProgramData,
# and serves the API documentation at /docs. Never set on anything reachable
# from a network.
#SYSWATCH_DEV_MODE=false

# Opens every endpoint and treats every caller as an administrator. Development
# only; the startup log says so loudly when it is on.
#SYSWATCH_AUTH_ENABLED=true

#SYSWATCH_SESSION_TTL_SECONDS=28800
