# SysWatch backend configuration.
#
# Copy this to syswatch.env next to the backend, or point SYSWATCH_CONFIG_FILE
# at it, and uncomment what you need. Environment variables override anything
# set here, so a one-off change does not need this file edited.
#
# syswatch.env itself is gitignored. This example is not, so keep real secrets
# out of it.

# --- required in production --------------------------------------------------

# The HMAC key for session tokens. There is no default and the process refuses
# to start without one. Generate with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it logs everyone out, so do not regenerate it on each deploy.
#SYSWATCH_SESSION_SECRET=

# --- serving -----------------------------------------------------------------

#SYSWATCH_HOST=127.0.0.1
#SYSWATCH_PORT=8000

# Where `npm run build` put the dashboard. Unset serves the API only, which is
# what you want while running the Vite dev server.
#SYSWATCH_DASHBOARD_DIR=C:\SysWatch\dashboard\dist

# Only needed when the dashboard is served from a different origin. With the
# dashboard served from this process there is one origin and none of this
# applies. Comma-separated; "*" is refused at startup.
#SYSWATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- data --------------------------------------------------------------------

#SYSWATCH_DATABASE_URL=sqlite:///./syswatch.db
#SYSWATCH_RETENTION_DAYS=30

# --- collection --------------------------------------------------------------

#SYSWATCH_AGENT_BASE_URL=http://127.0.0.1:8080
#SYSWATCH_POLL_INTERVAL_SECONDS=10.0
#SYSWATCH_POLLING_ENABLED=true
#SYSWATCH_ALERTS_ENABLED=true

# --- development ---------------------------------------------------------------

# Drops the session cookie's Secure flag so it survives plain HTTP. Never set
# this on anything reachable from a network.
#SYSWATCH_DEV_MODE=false

# Opens every endpoint and treats every caller as an administrator. Development
# only; the startup log says so loudly when it is on.
#SYSWATCH_AUTH_ENABLED=true

#SYSWATCH_SESSION_TTL_SECONDS=28800
